eventinvitation.freedynamicdns.net {
    # Backend Spring Boot API — context-path /api is already on the container
    handle /api/* {
        reverse_proxy backend:8080
    }

    # MinIO bucket — presigned PUT/GET URLs from the browser land here
    # Caddy passes the original Host header through so MinIO signature verification passes
    handle /event-media/* {
        reverse_proxy minio:9000
    }

    # React SPA — all other paths
    handle {
        reverse_proxy frontend:80
    }
}
