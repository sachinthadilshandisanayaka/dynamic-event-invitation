# Database
POSTGRES_DB=eventinvite
POSTGRES_USER=eventinvite
POSTGRES_PASSWORD=eventinvite2024

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
# MINIO_ENDPOINT = URL the backend uses to connect to MinIO AND generate presigned upload URLs.
# On the production server this is the server's direct HTTP address (port 9000).
# The frontend rewrites the presigned URL host to the Vercel domain before uploading,
# so the browser never touches the MinIO HTTP URL directly.
MINIO_ENDPOINT=http://95.216.188.135:9000
MINIO_ACCESS_KEY=eventinvite
MINIO_SECRET_KEY=EventInvite2024!
MINIO_BUCKET=event-media
# MINIO_PUBLIC_URL = base URL embedded into CDN URLs returned to the frontend.
# Set to the Vercel domain so media is served over HTTPS via Vercel's /event-media/ proxy.
MINIO_PUBLIC_URL=https://dynamic-event-invitation.vercel.app

# JWT (generate a secure 256-bit key for production)
JWT_SECRET=YourSuperSecretJwtKeyThatIsAtLeast256BitsLong_ChangeInProduction!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — frontend origin(s)
CORS_ALLOWED_ORIGINS=https://dynamic-event-invitation.vercel.app

# Optional SMTP (leave empty to disable email, notifications log to DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
