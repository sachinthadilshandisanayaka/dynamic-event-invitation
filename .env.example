# Database
POSTGRES_DB=eventinvite
POSTGRES_USER=eventinvite
POSTGRES_PASSWORD=eventinvite2024

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
# IMPORTANT: must be the PUBLIC domain, not the internal 'minio:9000'.
# The MinIO SDK signs presigned upload URLs using this host. The browser
# sends the PUT to this URL, so the host in the URL must match the signature.
MINIO_ENDPOINT=https://eventinvitation.freedynamicdns.net
MINIO_ACCESS_KEY=eventinvite
MINIO_SECRET_KEY=EventInvite2024!
MINIO_BUCKET=event-media
MINIO_PUBLIC_URL=https://eventinvitation.freedynamicdns.net

# Frontend build-time API URL (baked into the JS bundle at docker build time)
VITE_API_URL=https://eventinvitation.freedynamicdns.net
VITE_MINIO_PUBLIC_URL=https://eventinvitation.freedynamicdns.net

# JWT (generate a secure 256-bit key for production)
JWT_SECRET=YourSuperSecretJwtKeyThatIsAtLeast256BitsLong_ChangeInProduction!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=https://eventinvitation.freedynamicdns.net

# Optional SMTP (leave empty to disable email, notifications log to DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@eventinvitation.freedynamicdns.net
