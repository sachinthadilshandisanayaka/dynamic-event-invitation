# Database
POSTGRES_DB=eventinvite
POSTGRES_USER=eventinvite
POSTGRES_PASSWORD=eventinvite2024

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO (if running on same host outside Docker, use server IP not 'minio')
MINIO_ENDPOINT=http://95.216.188.135:9000
MINIO_ACCESS_KEY=eventinvite
MINIO_SECRET_KEY=EventInvite2024!
MINIO_BUCKET=event-media
MINIO_PUBLIC_URL=http://95.216.188.135:9000

# Frontend build-time API URL (baked into the JS bundle — must be the public IP)
VITE_API_URL=http://95.216.188.135:8090
VITE_MINIO_PUBLIC_URL=http://95.216.188.135:9000

# JWT  (generate a secure 256-bit key for production)
JWT_SECRET=YourSuperSecretJwtKeyThatIsAtLeast256BitsLong_ChangeInProduction!
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS — must include the public frontend URL
CORS_ALLOWED_ORIGINS=http://95.216.188.135:8091

# Optional SMTP (leave empty to disable email, notifications log to DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
